{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compileOnSave": true,
  "compilerOptions": {
    "baseUrl": ".",
    "isolatedModules": true,
    "outDir": "./dist",
    "sourceMap": true,
    "noEmit": false,
    "allowJs": false,
    "strict": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "experimentalDecorators": true,
    "typeRoots": ["./server/@types", "./node_modules/@types"],
    "paths": {
      "@car-types/*": ["server/@types/*"]
    }
  },
  "exclude": [
    "node_modules",
    "assets/**/*.js",
    "integration_tests",
    "cypress_shared",
    "dist",
    "scripts",
    "coverage",
    "esbuild",
    "**/tests/integration/**",
    "**/*.spec.ts"
  ],
  "include": ["**/*.js", "**/*.ts"]
}
