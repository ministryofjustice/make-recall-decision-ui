{% extends "../../../../partials/layout.njk" %}

{% set pageTitle = makePageTitle({ pageHeading: pageHeadings[page.id], hasErrors: errors }) %}

{% block beforeContent %}
  {{ backLink() }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds-from-desktop">
    {% include '../../../../partials/error-summary.njk' %}

    <form novalidate method="post">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        {% call govukFieldset({
          legend: {
            text: pageHeadings[page.id],
            classes: "govuk-fieldset__legend--l",
            isPageHeading: true
          }
        }) %}
            {{ govukInput({
              label: {
                text: "User name",
                classes: "govuk-label--m"
              },
              id: "userName",
              name: "userName",
              classes: "govuk-input--width-20",
              value: userMapping.userName,
              errorMessage: errorMessage(errors.userName)
            }) }}

            {{ govukInput({
              label: {
                text: "PPUD user full name",
                classes: "govuk-label--m"
              },
              id: "ppudUserFullName",
              name: "ppudUserFullName",
              classes: "govuk-input--width-20",
              value: userMapping.ppudUserFullName,
              errorMessage: errorMessage(errors.ppudUserFullName)
              }) }}

            {{ govukInput({
              label: {
                text: "PPUD team name",
                classes: "govuk-label--m"
              },
              id: "ppudTeamName",
              name: "ppudTeamName",
              classes: "govuk-input--width-20",
              value: userMapping.ppudTeamName,
              errorMessage: errorMessage(errors.ppudTeamName)
            }) }}

            {{ govukInput({
              label: {
                text: "PPUD user name",
                classes: "govuk-label--m"
              },
              id: "ppudUserName",
              name: "ppudUserName",
              classes: "govuk-input--width-20",
              value: userMapping.ppudUserName,
              errorMessage: errorMessage(errors.ppudUserName)
            }) }}
        {% endcall %}
      {{ formSubmitButton( { label: action }) }}
    </form>

  </div>
</div>
{% endblock %}
