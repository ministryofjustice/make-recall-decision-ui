{% extends "../../../../partials/layout.njk" %}

{% set pageTitle = makePageTitle({ pageHeading: pageHeadings[page.id], hasErrors: errors }) %}

{% block beforeContent %}
  {{ backLink() }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds-from-desktop">
    <h1 class='govuk-heading-l'>{{ pageHeadings[page.id] }}</h1>

    <table class="govuk-table">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">NDelius username</th>
          <th scope="col" class="govuk-table__header">PPUD full name</th>
          <th scope="col" class="govuk-table__header">PPUD team name</th>
          <th scope="col" class="govuk-table__header">PPUD username</th>
          <th scope="col" class="govuk-table__header"></th>
          <th scope="col" class="govuk-table__header"></th>
        </tr>
      </thead>

      <tbody class="govuk-table__body">
      {% for userMapping in userMappings %}
        <tr class="govuk-table__row">
          <td class="govuk-table__cell">{{ userMapping.userName }}</td>
          <td class="govuk-table__cell">{{ userMapping.ppudUserFullName }}</td>
          <td class="govuk-table__cell">{{ userMapping.ppudTeamName }}</td>
          <td class="govuk-table__cell">{{ userMapping.ppudUserName }}</td>
          <td class="govuk-table__cell"><a href="/ppud-user-mappings/{{ userMapping.id }}">Edit</a></td>
          <td class="govuk-table__cell"><a href="/ppud-user-mappings/{{ userMapping.id }}/delete">Delete</a></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>

    {{ govukButton({
      text: "Add new entry",
      href: "/ppud-user-mappings/add"
    }) }}
  </div>
</div>
{% endblock %}
