{% extends "../../partials/layout.njk" %}

{% set pageTitle = makePageTitle({ pageHeading: pageTitles[page.id], hasErrors: errors }) %}

{% block beforeContent %}
    {{ backLink() }}
{% endblock %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds-from-desktop">
            {% include '../../partials/error-summary.njk' %}

            {% set partAHtml %}
                <div class="car-text-list">
                    <h2 class='govuk-heading-m'>From Part A</h2>
                    <div class="car-text-list__row">
                        <div class="car-text-list__key">MAPPA Level</div>
                        <div class="car-text-list__value" data-qa="mappaLevel">
                            {% if recommendation.personOnProbation.mappa.level is defined and recommendation.personOnProbation.mappa.level !== null %}
                                Level {{ recommendation.personOnProbation.mappa.level }}
                            {% else %}
                                N/A
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endset %}

            <form novalidate method="post">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

                {{ govukRadios({
                    idPrefix: "mappaLevel",
                    name: "mappaLevel",
                    fieldset: {
                      legend: {
                        text: pageHeadings[page.id],
                        classes: "govuk-heading-l",
                        isPageHeading: true
                      }
                    },
                    formGroup: {
                      beforeInputs: {
                        html: partAHtml
                      }
                    },
                    items: radioCheckboxItems({
                        items: mappaLevels,
                        currentValues: recommendation.bookRecallToPpud.mappaLevel
                    }),
                    errorMessage: errorMessage(errors.mappaLevel)
                }) }}

                {{ formSubmitButton() }}
            </form>
        </div>
    </div>
{% endblock %}
