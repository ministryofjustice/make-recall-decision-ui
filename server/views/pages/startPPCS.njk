{% extends "../partials/layout.njk" %}

{% set pageTitle = makePageTitle({ pageHeading: "Start page for PPCS" }) %}
{% block beforeContent %}
    {% if not maintenanceBanner.isHidden %}
        {{ notificationBanner(maintenanceBanner) }}
    {% endif %}
{% endblock %}
{% block content %}
    {% if not validMappingAndPpudUser %}
        <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert"
             data-module="govuk-error-summary" data-qa="error-list">
            <h2 class="govuk-error-summary__title" id="error-summary-title">
                There is a problem
            </h2>
            <div class="govuk-error-summary__body">
                <p class='govuk-body'>
                    Your account needs updating before you can book a recall. Contact Service Now with your NDelius and
                    PPUD user names to complete this.
                </p>
            </div>
        </div>
    {% endif %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds-from-desktop">
            <h1 class="govuk-heading-l">Check and book a recall</h1>
            <p>Use this service to:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>review in-hours recall requests created in the Consider a recall service</li>
                <li>upload supporting documents</li>
                <li>add minutes</li>
                <li>book recalls on to PPUD</li>
            </ul>

            <p>You can only use this service for people serving <strong>determinate sentences</strong>.</p>

            <p>To book on a recall for someone serving an indeterminate sentence, use PPUD.</p>

            <a href="/ppcs-search" role="button" draggable="false"
               class="govuk-button govuk-button--start govuk-!-margin-top-2 govuk-!-margin-bottom-8"
               data-module="govuk-button">
                Start now
                <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19"
                     viewBox="0 0 33 40" role="presentation" focusable="false">
                    <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z"></path>
                </svg>
            </a>
        </div>
    </div>
{% endblock %}
